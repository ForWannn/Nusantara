# Asisten AI Nusantara — salin ke .env.local untuk mengaktifkan mode AI.
# Tanpa konfigurasi ini, asisten memakai mode arsip lokal (demo).
#
# Provider yang didukung: openai, openai-compatible, anthropic
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Opsional untuk provider yang kompatibel dengan OpenAI atau proxy.
# Contoh OpenAI: https://api.openai.com/v1
# Contoh OpenRouter: https://openrouter.ai/api/v1
#   AI_MODEL=recursive/flint-v1.0:free
AI_BASE_URL=
